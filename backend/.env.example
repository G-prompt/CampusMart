# Runtime PostgreSQL connection. Use the CampusMart database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusmart?schema=public"

# Direct PostgreSQL connection used by Prisma CLI and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/campusmart?schema=public"

# Authentication signing secrets; replace both values with long random secrets.
JWT_SECRET="replace_with_a_long_random_secret"
ADMIN_JWT_SECRET="replace_with_a_different_long_random_secret"

# Required by the backend at startup for private verification uploads.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="replace_with_your_supabase_secret_key"
