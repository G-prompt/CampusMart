generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  vendor
}

enum AdminRole {
  super_admin
  verification_officer
  university_manager
  marketplace_moderator
  customer_support
  disputes
  finance
  technical_admin
}

enum StudentVerificationStatus {
  not_started
  pending
  verified
  failed
}

enum StudentVerificationSource {
  none
  university_database
  university_api
  university_roster_import
  manual_document_review
  university_manual_confirmation
}

enum VendorVerificationStatus {
  not_started
  pending
  verified
  rejected
}

enum VendorAccessStatus {
  active
  pending_review
  restricted
  suspended
}

/**
 * Temporary legacy configuration.
 * Keep this until the application has fully migrated
 * away from the old single verification-method model.
 */
enum UniversityVerificationMethod {
  none
  manual
  database
  api
}

/**
 * Automated verification sources.
 * Manual review deliberately remains a separate
 * exception path.
 */
enum UniversityVerificationSourceType {
  none
  university_api
  roster_import
  university_database
}

/**
 * Lifecycle of an imported university roster.
 */
enum UniversityRosterImportStatus {
  processing
  active
  archived
  failed
}

enum VerificationAppealStatus {
  draft
  pending
  under_review
  more_information_required
  approved
  rejected
  cancelled
}

enum VerificationAppealReason {
  record_not_found
  university_system_unavailable
  recent_admission_or_transfer
  integration_error
  university_not_supported
  other
}

enum VerificationEvidenceType {
  student_id
  student_portal
  institutional_email
  admission_record
  other
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

/**
 * Why a buyer and seller are talking.
 */
enum ConversationContextType {
  general
  listing
  order
}

/**
 * Categories recorded when CampusMart detects an
 * off-platform/contact-sharing attempt.
 * The sensitive value itself is NOT stored here.
 */
enum MessagingModerationCategory {
  phone_number
  email
  external_username
  external_link
  bank_details
  off_platform_payment
  circumvention
}

/**
 * Only suspicious attempts are recorded.
 * Allowed messages do not need moderation-event rows.
 */
enum MessagingModerationAction {
  redacted
  blocked
}

enum MessagingModerationSeverity {
  low
  medium
  high
}

model University {
  id String @id @default(uuid())

  name      String
  shortName String
  slug      String @unique

  country String @default("Nigeria")
  state   String
  city    String

  logoUrl String?

  active Boolean @default(true)

  studentVerificationEnabled Boolean @default(false)

  /**
   * Legacy compatibility field.
   */
  verificationMethod UniversityVerificationMethod @default(none)

  /**
   * Source-aware verification architecture.
   */
  primaryVerificationSource UniversityVerificationSourceType @default(none)

  fallbackVerificationSource UniversityVerificationSourceType @default(none)

  manualReviewEnabled Boolean @default(false)

  /**
   * Matric-number format validation is only an
   * input-quality check.
   */
  matricValidationEnabled Boolean @default(false)

  /**
   * Private Admin/backend configuration.
   */
  matricPattern String?

  /**
   * Safe student-facing format hint.
   */
  matricFormatHint String?

  users User[]

  verificationAppeals VerificationAppeal[]

  rosterImports UniversityRosterImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([state])
  @@index([city])
  @@index([primaryVerificationSource])
  @@index([fallbackVerificationSource])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(client)

  phone String?
  bio   String?

  /**
   * Temporary legacy compatibility field.
   */
  campus String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  /**
   * Stored in normalized/canonical form.
   */
  matricNumber String?

  studentVerificationStatus StudentVerificationStatus @default(not_started)

  studentVerificationSource StudentVerificationSource @default(none)

  studentVerifiedAt DateTime?

  /**
   * Used where the student's university is not currently
   * represented by a managed CampusMart University row.
   */
  fallbackUniversityName String?
  fallbackState          String?
  fallbackCity           String?

  /**
   * Messaging-only restriction.
   */
  messagingRestrictedUntil DateTime?

  /**
   * Internal reason/code only.
   * Never store copied sensitive values here.
   */
  messagingRestrictionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  vendorProfile VendorProfile?

  verificationAppeals VerificationAppeal[]

  buyerOrders Order[] @relation("BuyerOrders")

  vendorOrderItems OrderItem[] @relation("VendorOrderItems")

  vendorFulfillments OrderVendorFulfillment[] @relation("VendorFulfillments")

  buyerConversations Conversation[] @relation("BuyerConversations")

  vendorConversations Conversation[] @relation("VendorConversations")

  sentMessages Message[] @relation("SentMessages")

  messagingModerationEvents MessagingModerationEvent[] @relation("MessagingModerationActor")

  @@unique([universityId, matricNumber])
  @@index([universityId])
  @@index([fallbackState])
  @@index([studentVerificationStatus])
  @@index([studentVerificationSource])
  @@index([messagingRestrictedUntil])
}

model Admin {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String

  role AdminRole

  active Boolean @default(true)

  createdByAdminId String?

  createdByAdmin Admin? @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAdmins Admin[] @relation("AdminCreatedBy")

  reviewedVerificationAppeals VerificationAppeal[] @relation("VerificationAppealReviewer")

  importedUniversityRosters UniversityRosterImport[] @relation("UniversityRosterImportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([createdByAdminId])
}

model VendorProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String
  pickupLocation      String

  /**
   * Temporary legacy compatibility field.
   */
  verified Boolean @default(false)

  accessStatus VendorAccessStatus @default(active)

  vendorVerificationStatus VendorVerificationStatus @default(not_started)

  verificationSubmittedAt DateTime?

  vendorVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accessStatus])
  @@index([vendorVerificationStatus])
}

model VerificationAppeal {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  reason VerificationAppealReason

  explanation String?

  status VerificationAppealStatus @default(draft)

  submittedName String

  submittedMatricNumber String?

  submittedUniversityName String

  submittedState String?

  submittedCity String?

  decisionReason String?

  reviewedByAdminId String?

  reviewedByAdmin Admin? @relation("VerificationAppealReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  submittedAt DateTime?

  reviewedAt DateTime?

  updatedAt DateTime @updatedAt

  evidence VerificationAppealEvidence[]

  @@index([userId])
  @@index([universityId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([reviewedByAdminId])
}

model VerificationAppealEvidence {
  id String @id @default(uuid())

  appealId String
  appeal   VerificationAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  type VerificationEvidenceType

  storageKey String

  originalFileName String?

  mimeType String?

  fileSizeBytes Int?

  createdAt DateTime @default(now())

  @@index([appealId])
  @@index([type])
}

model UniversityRosterImport {
  id String @id @default(uuid())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  importedByAdminId String?

  importedByAdmin Admin? @relation("UniversityRosterImportedBy", fields: [importedByAdminId], references: [id], onDelete: SetNull)

  academicSession String

  sourceIssuer String

  sourceReference String?

  originalFileName String

  fileSha256 String?

  status UniversityRosterImportStatus @default(processing)

  validFrom DateTime?

  expiresAt DateTime?

  recordCount Int @default(0)

  activeRecordCount Int @default(0)

  inactiveRecordCount Int @default(0)

  rejectedRowCount Int @default(0)

  failureReason String?

  importedAt DateTime @default(now())

  activatedAt DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  records UniversityRosterRecord[]

  @@index([universityId])
  @@index([universityId, status])
  @@index([universityId, expiresAt])
  @@index([importedByAdminId])
  @@index([status])
  @@index([importedAt])
}

model UniversityRosterRecord {
  id String @id @default(uuid())

  rosterImportId String
  rosterImport   UniversityRosterImport @relation(fields: [rosterImportId], references: [id], onDelete: Cascade)

  matricNumber String

  normalizedMatricNumber String

  fullName String

  normalizedFullName String

  studentStatus String

  isActiveStudent Boolean

  institutionalEmail String?

  sourceRowNumber Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([rosterImportId, normalizedMatricNumber])
  @@index([rosterImportId])
  @@index([normalizedMatricNumber])
  @@index([normalizedFullName])
  @@index([isActiveStudent])
  @@index([institutionalEmail])
}

model Product {
  id Int @id @default(autoincrement())

  slug String @unique

  title String

  category String

  price Int

  rating Float @default(0)

  description String

  images String[]

  vendorId String
  vendor   User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  isArchived Boolean @default(false)

  archivedAt DateTime?

  orderItems OrderItem[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived, createdAt])
  @@index([vendorId, isArchived])
}

model Order {
  id String @id @default(uuid())

  buyerId String
  buyer   User @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(pending)

  paymentStatus PaymentStatus @default(pending)

  subtotal Int

  fee Int @default(0)

  total Int

  pickupLocation String?

  preferredSlot String?

  items OrderItem[]

  vendorFulfillments OrderVendorFulfillment[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  vendorId String
  vendor   User @relation("VendorOrderItems", fields: [vendorId], references: [id], onDelete: Restrict)

  productTitle String

  unitPrice Int

  quantity Int

  lineTotal Int

  status OrderStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
}

model OrderVendorFulfillment {
  id String @id @default(uuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   User @relation("VendorFulfillments", fields: [vendorId], references: [id], onDelete: Restrict)

  codeHash String

  codeCiphertext String

  codeCreatedAt DateTime @default(now())

  verifiedAt DateTime?

  failedAttemptCount Int @default(0)

  lastFailedAttemptAt DateTime?

  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId])
  @@index([orderId])
  @@index([vendorId])
  @@index([vendorId, verifiedAt])
  @@index([lockedUntil])
}

/**
 * =======================================================
 * CONVERSATION
 * =======================================================
 */
model Conversation {
  id String @id @default(uuid())

  buyerId String
  buyer   User @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Restrict)

  vendorId String
  vendor   User @relation("VendorConversations", fields: [vendorId], references: [id], onDelete: Restrict)

  contextType ConversationContextType @default(general)

  /**
   * Examples:
   * general
   * listing:42
   * order:<uuid>
   */
  contextKey String

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /**
   * =====================================================
   * DELIVERY RECEIPTS
   * =====================================================
   */

  buyerLastDeliveredAt DateTime?

  vendorLastDeliveredAt DateTime?

  /**
   * =====================================================
   * READ RECEIPTS
   * =====================================================
   */

  buyerLastReadAt DateTime?

  vendorLastReadAt DateTime?

  lastMessageAt DateTime @default(now())

  messages Message[]

  moderationEvents MessagingModerationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, vendorId, contextKey])
  @@index([buyerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
  @@index([productId])
  @@index([orderId])
  @@index([contextType])
}

/**
 * =======================================================
 * MESSAGE
 * =======================================================
 */
model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  /**
   * Only the allowed or sanitized message reaches this
   * field.
   */
  body String

  /**
   * =====================================================
   * MESSAGE REPLIES
   * =====================================================
   *
   * The backend must verify that the target message
   * belongs to this same conversation before saving the
   * relationship.
   *
   * If the original Message row is ever physically
   * deleted, existing replies survive and this foreign
   * key becomes null.
   */

  replyToMessageId String?

  replyToMessage Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)

  replies Message[] @relation("MessageReplies")

  editedAt DateTime?

  deletedAt DateTime?

  /**
   * At most one moderation event belongs to the message
   * attempt that produced this stored message.
   *
   * Blocked attempts have no Message row at all.
   */
  moderationEvent MessagingModerationEvent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToMessageId])
}

/**
 * =======================================================
 * MESSAGING MODERATION EVENT
 * =======================================================
 */
model MessagingModerationEvent {
  id String @id @default(uuid())

  /**
   * User who attempted to send the suspicious message.
   */
  userId String
  user   User @relation("MessagingModerationActor", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Existing conversation when available.
   */
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /**
   * Stored sanitized message when the action was
   * `redacted`.
   *
   * Null for blocked attempts.
   */
  messageId String? @unique
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  contextType ConversationContextType?

  /**
   * Categories only.
   * Never store detected raw values here.
   */
  categories MessagingModerationCategory[]

  action MessagingModerationAction

  severity MessagingModerationSeverity @default(low)

  strikeWeight Int @default(1)

  warningCode String?

  requiresReview Boolean @default(false)

  restrictionAppliedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@index([requiresReview, createdAt])
}