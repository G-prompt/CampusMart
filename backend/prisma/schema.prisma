
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  vendor
}

enum AdminRole {
  super_admin
  verification_officer
  university_manager
  marketplace_moderator
  customer_support
  disputes
  finance
  technical_admin
}

enum StudentVerificationStatus {
  not_started
  pending
  verified
  failed
}

enum StudentVerificationSource {
  none
  university_database
  university_api
  university_roster_import
  manual_document_review
  university_manual_confirmation
}

enum VendorVerificationStatus {
  not_started
  pending
  verified
  rejected
}

enum VendorAccessStatus {
  active
  pending_review
  restricted
  suspended
}

enum UniversityVerificationMethod {
  none
  manual
  database
  api
}

enum UniversityVerificationSourceType {
  none
  university_api
  roster_import
  university_database
}

enum UniversityRosterImportStatus {
  processing
  active
  archived
  failed
}

enum VerificationAppealStatus {
  draft
  pending
  under_review
  more_information_required
  approved
  rejected
  cancelled
}

enum VerificationAppealReason {
  record_not_found
  university_system_unavailable
  recent_admission_or_transfer
  integration_error
  university_not_supported
  other
}

enum VerificationEvidenceType {
  student_id
  student_portal
  institutional_email
  admission_record
  other
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum WalletEntryKind {
  checkout_debit
  seller_refund
  service_fee_refund
  seller_settlement
  development_funding
}

enum WalletHoldStatus {
  held
  refunded
  settled
}

enum MarketplaceTargetType {
  user
  product
  order
}

enum MarketplaceReportCategory {
  suspected_fraud
  non_delivery
  misleading_listing
  harassment
  prohibited_item
  impersonation
  privacy_violation
  payment_dispute
  unsafe_meetup
  other
}

enum MarketplaceSeverity {
  low
  medium
  high
  critical
}

enum MarketplaceCaseStatus {
  open
  investigating
  action_taken
  dismissed
  closed
}

enum SellerBadgeKind {
  rising_star
  campus_favourite
  top_seller
}

enum InstitutionKind {
  university
  polytechnic
  other
}

enum RosterScope {
  unspecified
  institution
  faculty
  department
}

enum PickupPointType {
  campus
  hostel_block
  faculty_building
  custom
}

enum ConversationContextType {
  general
  listing
  order
}

enum MessagingModerationCategory {
  phone_number
  email
  external_username
  external_link
  bank_details
  off_platform_payment
  circumvention
}

enum MessagingModerationAction {
  redacted
  blocked
}

enum MessagingModerationSeverity {
  low
  medium
  high
}

enum NotificationType {
  order_received
  order_confirmed
  order_cancelled
  order_completed
  order_ready
  university_available
}

model University {
  id String @id @default(uuid())

  name      String
  shortName String
  slug      String @unique

  country String @default("Nigeria")
  state   String
  city    String

  logoUrl String?

  active Boolean @default(true)
  institutionKind InstitutionKind @default(university)
  featuredInSignup Boolean @default(false)
  sellerApplicationsOpen Boolean @default(false)

  studentVerificationEnabled Boolean @default(false)

  verificationMethod UniversityVerificationMethod @default(none)

  primaryVerificationSource  UniversityVerificationSourceType @default(none)
  fallbackVerificationSource UniversityVerificationSourceType @default(none)

  manualReviewEnabled Boolean @default(false)

  matricValidationEnabled Boolean @default(false)
  matricPattern           String?
  matricFormatHint        String?

  users               User[]
  verificationAppeals VerificationAppeal[]
  rosterImports       UniversityRosterImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([state])
  @@index([city])
  @@index([primaryVerificationSource])
  @@index([fallbackVerificationSource])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(client)

  phone String?
  bio   String?

  campus String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  matricNumber String?

  studentVerificationStatus StudentVerificationStatus @default(not_started)
  studentVerificationSource StudentVerificationSource @default(none)
  studentVerifiedAt         DateTime?

  fallbackUniversityName String?
  fallbackState          String?
  fallbackCity           String?

  messagingRestrictedUntil   DateTime?
  messagingRestrictionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  vendorProfile VendorProfile?
  sellerBadges SellerBadgeAward[]
  submittedReports MarketplaceReport[] @relation("MarketplaceReportAuthor")
  accountFlaggedAt DateTime?
  accountFlagReason String? @db.Text
  accountSuspendedAt DateTime?
  accountSuspensionReason String? @db.Text
  moderationSellerAccessBeforeSuspension VendorAccessStatus?

  vendorPickupPoints VendorPickupPoint[] @relation("VendorPickupPoints")

  vendorPickupSelections OrderVendorPickupSelection[] @relation("VendorPickupSelections")

  verificationAppeals VerificationAppeal[]

  buyerOrders Order[] @relation("BuyerOrders")

  vendorOrderItems OrderItem[] @relation("VendorOrderItems")

  vendorFulfillments OrderVendorFulfillment[] @relation("VendorFulfillments")

  buyerConversations Conversation[] @relation("BuyerConversations")

  vendorConversations Conversation[] @relation("VendorConversations")

  sentMessages Message[] @relation("SentMessages")

  messagingModerationEvents MessagingModerationEvent[] @relation("MessagingModerationActor")

  notifications Notification[]

  productReviews ProductReview[] @relation("BuyerProductReviews")
  wallet Wallet?
  walletEntries WalletEntry[]

  @@unique([universityId, matricNumber])
  @@index([universityId])
  @@index([fallbackState])
  @@index([studentVerificationStatus])
  @@index([studentVerificationSource])
  @@index([messagingRestrictedUntil])
}

model Admin {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String

  role AdminRole

  active Boolean @default(true)

  createdByAdminId String?

  createdByAdmin Admin? @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAdmins Admin[] @relation("AdminCreatedBy")

  auditLogs AdminAuditLog[] @relation("AdminAuditActor")
  grantedSellerBadges SellerBadgeAward[] @relation("SellerBadgeGrantAdmin")

  reviewedVerificationAppeals VerificationAppeal[] @relation("VerificationAppealReviewer")

  importedUniversityRosters UniversityRosterImport[] @relation("UniversityRosterImportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([createdByAdminId])
}

model VendorProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String

  pickupLocation String

  verified Boolean @default(false)

  accessStatus VendorAccessStatus @default(active)

  vendorVerificationStatus VendorVerificationStatus @default(not_started)

  verificationSubmittedAt DateTime?

  vendorVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accessStatus])
  @@index([vendorVerificationStatus])
}

model VendorPickupPoint {
  id String @id @default(uuid())

  vendorId String

  vendor User @relation("VendorPickupPoints", fields: [vendorId], references: [id], onDelete: Cascade)

  type PickupPointType

  label String

  detail String?

  isActive Boolean @default(true)

  orderSelections OrderVendorPickupSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, isActive])
  @@index([vendorId, createdAt])
}

model VerificationAppeal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  reason VerificationAppealReason

  explanation String?

  status VerificationAppealStatus @default(draft)

  submittedName String

  submittedMatricNumber String?

  submittedUniversityName String

  submittedState String?

  submittedCity String?

  decisionReason String?

  reviewedByAdminId String?

  reviewedByAdmin Admin? @relation("VerificationAppealReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  submittedAt DateTime?

  reviewedAt DateTime?

  updatedAt DateTime @updatedAt

  evidence VerificationAppealEvidence[]

  @@index([userId])
  @@index([universityId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([reviewedByAdminId])
}

model VerificationAppealEvidence {
  id String @id @default(uuid())

  appealId String
  appeal   VerificationAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  type VerificationEvidenceType

  storageKey String

  originalFileName String?

  mimeType String?

  fileSizeBytes Int?

  createdAt DateTime @default(now())

  @@index([appealId])
  @@index([type])
}

model UniversityRosterImport {
  id String @id @default(uuid())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  importedByAdminId String?

  importedByAdmin Admin? @relation("UniversityRosterImportedBy", fields: [importedByAdminId], references: [id], onDelete: SetNull)

  academicSession String

  sourceIssuer String

  sourceReference String?

  currentStudentsOnlyDeclared Boolean @default(false)
  rosterScope RosterScope @default(unspecified)
  sourceUnit String?
  trustedForAutomatedVerification Boolean @default(false)

  originalFileName String

  fileSha256 String?

  status UniversityRosterImportStatus @default(processing)

  validFrom DateTime?

  expiresAt DateTime?

  recordCount Int @default(0)

  activeRecordCount Int @default(0)

  inactiveRecordCount Int @default(0)

  rejectedRowCount Int @default(0)

  failureReason String?

  importedAt DateTime @default(now())

  activatedAt DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  records UniversityRosterRecord[]

  @@index([universityId])
  @@index([universityId, status])
  @@index([universityId, expiresAt])
  @@index([importedByAdminId])
  @@index([status])
  @@index([importedAt])
}

model UniversityRosterRecord {
  id String @id @default(uuid())

  rosterImportId String
  rosterImport   UniversityRosterImport @relation(fields: [rosterImportId], references: [id], onDelete: Cascade)

  matricNumber String

  normalizedMatricNumber String

  fullName String

  normalizedFullName String

  studentStatus String

  isActiveStudent Boolean

  institutionalEmail String?

  sourceRowNumber Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([rosterImportId, normalizedMatricNumber])
  @@index([rosterImportId])
  @@index([normalizedMatricNumber])
  @@index([normalizedFullName])
  @@index([isActiveStudent])
  @@index([institutionalEmail])
}

model Product {
  id Int @id @default(autoincrement())

  slug String @unique

  title String

  category String

  price Int

  rating Float @default(0)

  description String

  images String[]

  sizes String[] @default([])

  colors String[] @default([])

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  isArchived Boolean @default(false)
  moderationHiddenAt DateTime?
  moderationHiddenReason String? @db.Text

  archivedAt DateTime?

  orderItems OrderItem[]

  conversations Conversation[]

  reviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived, createdAt])
  @@index([vendorId, isArchived])
}

model ProductReview {
  id String @id @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User @relation("BuyerProductReviews", fields: [buyerId], references: [id], onDelete: Cascade)

  rating Int

  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, buyerId])
  @@index([productId, createdAt])
  @@index([buyerId, createdAt])
}

model Order {
  id String @id @default(uuid())

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(pending)

  paymentStatus PaymentStatus @default(pending)

  subtotal Int

  fee Int @default(0)

  total Int

  pickupLocation String?

  preferredSlot String?
  secondaryPhone String?
  checkoutKey String? @unique
  walletHolds WalletHold[]

  items OrderItem[]

  vendorFulfillments OrderVendorFulfillment[]

  vendorPickupSelections OrderVendorPickupSelection[]

  conversations Conversation[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  vendorId String
  vendor   User   @relation("VendorOrderItems", fields: [vendorId], references: [id], onDelete: Restrict)

  productTitle String

  unitPrice Int

  quantity Int

  lineTotal Int

  selectedSize String?

  selectedColor String?

  status OrderStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
}

model OrderVendorPickupSelection {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   User   @relation("VendorPickupSelections", fields: [vendorId], references: [id], onDelete: Restrict)

  pickupPointId String?

  pickupPoint VendorPickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  type PickupPointType

  label String

  detail String?

  createdAt DateTime @default(now())

  @@unique([orderId, vendorId])
  @@index([vendorId])
  @@index([pickupPointId])
}

model OrderVendorFulfillment {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   User   @relation("VendorFulfillments", fields: [vendorId], references: [id], onDelete: Restrict)

  codeHash String

  codeCiphertext String

  codeCreatedAt DateTime @default(now())

  verifiedAt DateTime?

  // Set once when this vendor confirms its portion.
  confirmedAt DateTime?
  deliveryDueAt DateTime?
  readyAt DateTime?

  failedAttemptCount Int @default(0)

  lastFailedAttemptAt DateTime?

  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId])
  @@index([orderId])
  @@index([vendorId])
  @@index([vendorId, verifiedAt])
  @@index([verifiedAt, vendorId])
  @@index([lockedUntil])
}

model Conversation {
  id String @id @default(uuid())

  buyerId String
  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Restrict)

  vendorId String
  vendor   User   @relation("VendorConversations", fields: [vendorId], references: [id], onDelete: Restrict)

  contextType ConversationContextType @default(general)

  contextKey String

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  buyerLastDeliveredAt DateTime?

  vendorLastDeliveredAt DateTime?

  buyerLastReadAt DateTime?

  vendorLastReadAt DateTime?

  lastMessageAt DateTime @default(now())

  messages Message[]

  moderationEvents MessagingModerationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, vendorId, contextKey])
  @@index([buyerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
  @@index([productId])
  @@index([orderId])
  @@index([contextType])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  body String

  replyToMessageId String?

  replyToMessage Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)

  replies Message[] @relation("MessageReplies")

  editedAt DateTime?

  deletedAt DateTime?

  moderationEvent MessagingModerationEvent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToMessageId])
}

model MessagingModerationEvent {
  id String @id @default(uuid())

  userId String
  user   User   @relation("MessagingModerationActor", fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  messageId String? @unique
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  contextType ConversationContextType?

  categories MessagingModerationCategory[]

  action MessagingModerationAction

  severity MessagingModerationSeverity @default(low)

  strikeWeight Int @default(1)

  warningCode String?

  requiresReview Boolean @default(false)

  restrictionAppliedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@index([requiresReview])
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String

  message String

  href String?

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([orderId])
}

model Wallet {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletEntry {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  reference String @unique
  kind WalletEntryKind
  amount Int
  orderId String?
  vendorId String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([orderId])
}

model WalletHold {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId String
  amount Int
  status WalletHoldStatus @default(held)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, vendorId])
  @@index([vendorId, status])
}


/// Immutable-by-application administrator activity record.
/// Sensitive documents, passwords and tokens must never be copied into the log.
model AdminAuditLog {
  id String @id @default(uuid())
  actorAdminId String
  actor Admin @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  action String
  targetType String
  targetId String
  reason String?
  beforeState String? @db.Text
  afterState String? @db.Text
  outcome String @default("success")
  createdAt DateTime @default(now())

  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

/// Performance badge; audit records preserve full grant/revoke history.
model SellerBadgeAward {
  id String @id @default(uuid())
  vendorId String
  vendor User @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  kind SellerBadgeKind
  active Boolean @default(true)
  reason String @db.Text
  grantedByAdminId String
  grantedByAdmin Admin @relation("SellerBadgeGrantAdmin", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  revokedReason String? @db.Text
  updatedAt DateTime @updatedAt
  @@unique([vendorId, kind])
  @@index([kind, active])
  @@index([vendorId, active])
}

/// One reviewable case per reported target; users cannot escalate priority by repeatedly reporting it.
model MarketplaceCase {
  id String @id @default(uuid())
  targetType MarketplaceTargetType
  targetId String
  universityId String?
  status MarketplaceCaseStatus @default(open)
  highestSeverity MarketplaceSeverity @default(low)
  reportCount Int @default(0)
  priorityScore Int @default(0)
  lastReportedAt DateTime @default(now())
  resolutionNote String? @db.Text
  reports MarketplaceReport[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([targetType, targetId])
  @@index([status, priorityScore, lastReportedAt])
  @@index([targetType, status])
  @@index([universityId, status, priorityScore])
}

model MarketplaceReport {
  id String @id @default(uuid())
  caseId String
  case MarketplaceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  reporterId String
  reporter User @relation("MarketplaceReportAuthor", fields: [reporterId], references: [id], onDelete: Restrict)
  category MarketplaceReportCategory
  severity MarketplaceSeverity
  details String @db.Text
  createdAt DateTime @default(now())
  @@unique([caseId, reporterId])
  @@index([reporterId, createdAt])
  @@index([caseId, createdAt])
}
