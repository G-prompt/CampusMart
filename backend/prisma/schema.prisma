generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  vendor
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(client)

  campus String?
  phone  String?
  bio    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  vendorProfile VendorProfile?

  buyerOrders      Order[]     @relation("BuyerOrders")
  vendorOrderItems OrderItem[] @relation("VendorOrderItems")
}

model VendorProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String
  pickupLocation      String

  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  category    String
  price       Int
  rating      Float    @default(0)
  description String
  images      String[]

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(uuid())

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(pending)

  subtotal Int
  fee      Int @default(0)
  total    Int

  pickupLocation String?
  preferredSlot  String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  vendorId String
  vendor   User   @relation("VendorOrderItems", fields: [vendorId], references: [id], onDelete: Restrict)

  productTitle String
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  status OrderStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
}
