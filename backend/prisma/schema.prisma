generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  vendor
}

enum AdminRole {
  super_admin
  verification_officer
  university_manager
  marketplace_moderator
  customer_support
  disputes
  finance
  technical_admin
}

enum StudentVerificationStatus {
  not_started
  pending
  verified
  failed
}

enum StudentVerificationSource {
  none
  university_database
  university_api
  university_roster_import
  manual_document_review
  university_manual_confirmation
}

enum VendorVerificationStatus {
  not_started
  pending
  verified
  rejected
}

enum VendorAccessStatus {
  active
  pending_review
  restricted
  suspended
}

/**
 * Temporary legacy configuration.
 * Keep this until the application has fully migrated
 * away from the old single verification-method model.
 */
enum UniversityVerificationMethod {
  none
  manual
  database
  api
}

/**
 * Automated verification sources.
 * Manual review deliberately remains a separate
 * exception path.
 */
enum UniversityVerificationSourceType {
  none
  university_api
  roster_import
  university_database
}

/**
 * Lifecycle of an imported university roster.
 */
enum UniversityRosterImportStatus {
  processing
  active
  archived
  failed
}

enum VerificationAppealStatus {
  draft
  pending
  under_review
  more_information_required
  approved
  rejected
  cancelled
}

enum VerificationAppealReason {
  record_not_found
  university_system_unavailable
  recent_admission_or_transfer
  integration_error
  university_not_supported
  other
}

enum VerificationEvidenceType {
  student_id
  student_portal
  institutional_email
  admission_record
  other
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

model University {
  id String @id @default(uuid())

  name      String
  shortName String
  slug      String @unique

  country String @default("Nigeria")
  state   String
  city    String

  logoUrl String?

  active Boolean @default(true)

  studentVerificationEnabled Boolean @default(false)

  /**
   * Legacy compatibility field.
   */
  verificationMethod UniversityVerificationMethod @default(none)

  /**
   * Source-aware verification architecture.
   */
  primaryVerificationSource UniversityVerificationSourceType @default(none)

  fallbackVerificationSource UniversityVerificationSourceType @default(none)

  manualReviewEnabled Boolean @default(false)

  /**
   * Matric-number format validation is only an
   * input-quality check.
   */
  matricValidationEnabled Boolean @default(false)

  /**
   * Private Admin/backend configuration.
   */
  matricPattern String?

  /**
   * Safe student-facing format hint.
   */
  matricFormatHint String?

  users User[]

  verificationAppeals VerificationAppeal[]

  rosterImports UniversityRosterImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([state])
  @@index([city])
  @@index([primaryVerificationSource])
  @@index([fallbackVerificationSource])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(client)

  phone String?
  bio   String?

  /**
   * Temporary legacy compatibility field.
   */
  campus String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  /**
   * Stored in normalized/canonical form.
   */
  matricNumber String?

  studentVerificationStatus StudentVerificationStatus @default(not_started)

  studentVerificationSource StudentVerificationSource @default(none)

  studentVerifiedAt DateTime?

  /**
   * Used where the student's university is not currently
   * represented by a managed CampusMart University row.
   */
  fallbackUniversityName String?
  fallbackState          String?
  fallbackCity           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  vendorProfile VendorProfile?

  verificationAppeals VerificationAppeal[]

  buyerOrders Order[] @relation("BuyerOrders")

  vendorOrderItems OrderItem[] @relation("VendorOrderItems")

  /**
   * Seller-specific fulfilment records.
   *
   * One record represents this seller's portion of one
   * buyer order.
   */
  vendorFulfillments OrderVendorFulfillment[] @relation("VendorFulfillments")

  @@unique([universityId, matricNumber])
  @@index([universityId])
  @@index([fallbackState])
  @@index([studentVerificationStatus])
  @@index([studentVerificationSource])
}

model Admin {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String

  role AdminRole

  active Boolean @default(true)

  /**
   * Super Admin can eventually create other Admin
   * accounts.
   */
  createdByAdminId String?

  createdByAdmin Admin? @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAdmins Admin[] @relation("AdminCreatedBy")

  reviewedVerificationAppeals VerificationAppeal[] @relation("VerificationAppealReviewer")

  importedUniversityRosters UniversityRosterImport[] @relation("UniversityRosterImportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([createdByAdminId])
}

model VendorProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String
  pickupLocation      String

  /**
   * Temporary legacy compatibility field.
   */
  verified Boolean @default(false)

  /**
   * Seller access and seller identity verification
   * remain separate trust decisions.
   */
  accessStatus VendorAccessStatus @default(active)

  vendorVerificationStatus VendorVerificationStatus @default(not_started)

  verificationSubmittedAt DateTime?

  vendorVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accessStatus])
  @@index([vendorVerificationStatus])
}

model VerificationAppeal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  reason VerificationAppealReason

  explanation String?

  status VerificationAppealStatus @default(draft)

  /**
   * Snapshot of the identity details being reviewed.
   */
  submittedName String

  submittedMatricNumber String?

  submittedUniversityName String

  submittedState String?

  submittedCity String?

  decisionReason String?

  reviewedByAdminId String?

  reviewedByAdmin Admin? @relation("VerificationAppealReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  submittedAt DateTime?

  reviewedAt DateTime?

  updatedAt DateTime @updatedAt

  evidence VerificationAppealEvidence[]

  @@index([userId])
  @@index([universityId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([reviewedByAdminId])
}

model VerificationAppealEvidence {
  id String @id @default(uuid())

  appealId String
  appeal   VerificationAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  type VerificationEvidenceType

  /**
   * Private Supabase Storage reference.
   */
  storageKey String

  originalFileName String?

  mimeType String?

  fileSizeBytes Int?

  createdAt DateTime @default(now())

  @@index([appealId])
  @@index([type])
}

/**
 * =======================================================
 * UNIVERSITY ROSTER IMPORT
 * =======================================================
 * One import represents one university-supplied student
 * roster.
 * CampusMart keeps import metadata so freshness and
 * source authority can later be enforced.
 */
model UniversityRosterImport {
  id String @id @default(uuid())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  /**
   * Admin who imported the roster.
   */
  importedByAdminId String?

  importedByAdmin Admin? @relation("UniversityRosterImportedBy", fields: [importedByAdminId], references: [id], onDelete: SetNull)

  /**
   * Human-readable academic period.
   * Example:
   * 2025/2026
   */
  academicSession String

  /**
   * University registry, ICT unit, authorised officer,
   * or another approved issuer.
   */
  sourceIssuer String

  /**
   * Optional university-supplied source reference.
   */
  sourceReference String?

  /**
   * Original filename for audit/debugging.
   * This is not a public media URL.
   */
  originalFileName String

  /**
   * Optional SHA-256 file digest for future duplicate-file
   * detection.
   */
  fileSha256 String?

  status UniversityRosterImportStatus @default(processing)

  /**
   * Optional validity period provided by the institution.
   */
  validFrom DateTime?

  expiresAt DateTime?

  /**
   * Import processing statistics.
   */
  recordCount Int @default(0)

  activeRecordCount Int @default(0)

  inactiveRecordCount Int @default(0)

  rejectedRowCount Int @default(0)

  /**
   * Processing failure summary.
   * Do not store raw student information here.
   */
  failureReason String?

  importedAt DateTime @default(now())

  activatedAt DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  records UniversityRosterRecord[]

  @@index([universityId])
  @@index([universityId, status])
  @@index([universityId, expiresAt])
  @@index([importedByAdminId])
  @@index([status])
  @@index([importedAt])
}

/**
 * =======================================================
 * UNIVERSITY ROSTER RECORD
 * =======================================================
 * Minimal student identity information used for
 * automated university roster verification.
 */
model UniversityRosterRecord {
  id String @id @default(uuid())

  rosterImportId String
  rosterImport   UniversityRosterImport @relation(fields: [rosterImportId], references: [id], onDelete: Cascade)

  /**
   * Original matric/student number supplied by the
   * university.
   */
  matricNumber String

  /**
   * CampusMart-generated normalized representation used
   * for matching.
   */
  normalizedMatricNumber String

  /**
   * Original university-provided full name.
   */
  fullName String

  /**
   * CampusMart-generated normalized name used by the
   * future matching engine.
   */
  normalizedFullName String

  /**
   * Original university status value.
   */
  studentStatus String

  /**
   * CampusMart's normalized interpretation of whether
   * this record represents a currently eligible student.
   */
  isActiveStudent Boolean

  /**
   * Optional minimal secondary identifier.
   */
  institutionalEmail String?

  /**
   * Original CSV row number for operational debugging.
   */
  sourceRowNumber Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([rosterImportId, normalizedMatricNumber])
  @@index([rosterImportId])
  @@index([normalizedMatricNumber])
  @@index([normalizedFullName])
  @@index([isActiveStudent])
  @@index([institutionalEmail])
}

model Product {
  id Int @id @default(autoincrement())

  slug String @unique

  title String

  category String

  price Int

  rating Float @default(0)

  description String

  images String[]

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /**
   * Marketplace publication state.
   *
   * false = currently published
   * true  = archived / removed from public sale
   *
   * Archived products remain in the database so
   * historical orders, moderation and future disputes
   * retain their listing relationship.
   */
  isArchived Boolean @default(false)

  /**
   * Timestamp for when the product was archived.
   *
   * null means the listing is currently published.
   */
  archivedAt DateTime?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived, createdAt])
  @@index([vendorId, isArchived])
}

model Order {
  id String @id @default(uuid())

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(pending)

  paymentStatus PaymentStatus @default(pending)

  subtotal Int

  fee Int @default(0)

  total Int

  pickupLocation String?

  preferredSlot String?

  items OrderItem[]

  /**
   * One fulfilment record per seller represented in this
   * order.
   *
   * Example:
   *
   * order contains:
   * - two products from Seller A
   * - one product from Seller B
   *
   * this relation contains:
   * - one Seller A fulfilment
   * - one Seller B fulfilment
   */
  vendorFulfillments OrderVendorFulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  vendorId String
  vendor   User   @relation("VendorOrderItems", fields: [vendorId], references: [id], onDelete: Restrict)

  productTitle String

  unitPrice Int

  quantity Int

  lineTotal Int

  /**
   * Current fulfilment state for this item.
   *
   * All items belonging to one seller are currently
   * advanced together by the seller-order workflow.
   */
  status OrderStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
}

/**
 * =======================================================
 * ORDER VENDOR FULFILMENT
 * =======================================================
 *
 * Represents ONE SELLER'S portion of ONE ORDER.
 *
 * This exists separately from OrderItem because a seller
 * may have several items in the same buyer order but
 * should receive only one fulfilment challenge/code.
 *
 * Example:
 *
 * Buyer order:
 *
 * Seller A
 * - Laptop
 * - Mouse
 *
 * Seller B
 * - Textbook
 *
 * Fulfilment records:
 *
 * Order + Seller A -> one private code
 * Order + Seller B -> another private code
 *
 * The raw 4-digit code must never be stored directly.
 */
model OrderVendorFulfillment {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   User   @relation("VendorFulfillments", fields: [vendorId], references: [id], onDelete: Restrict)

  /**
   * Secure hash of the buyer's fulfilment code.
   *
   * The seller-submitted code is hashed and compared
   * against this value.
   *
   * The raw code must not be recoverable from this field.
   */
  codeHash String

  /**
   * Encrypted representation of the same fulfilment code.
   *
   * This allows the BUYER endpoint to decrypt and display
   * the code after the seller confirms the order.
   *
   * Seller-facing endpoints must never expose this value.
   */
  codeCiphertext String

  /**
   * When this fulfilment code became active.
   */
  codeCreatedAt DateTime @default(now())

  /**
   * Set when the seller successfully supplies the correct
   * fulfilment code.
   *
   * Successful validation will later cause all eligible
   * OrderItems for this order/vendor pair to become
   * completed.
   */
  verifiedAt DateTime?

  /**
   * Count incorrect fulfilment-code attempts.
   *
   * A 4-digit code only has 10,000 combinations, so the
   * backend must never permit unlimited guesses.
   */
  failedAttemptCount Int @default(0)

  /**
   * Most recent incorrect code attempt.
   */
  lastFailedAttemptAt DateTime?

  /**
   * Temporary lock used after too many failed attempts.
   *
   * While this is in the future, fulfilment-code
   * verification must be rejected.
   */
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * One seller can have only one fulfilment challenge for
   * one buyer order.
   */
  @@unique([orderId, vendorId])

  @@index([orderId])
  @@index([vendorId])
  @@index([vendorId, verifiedAt])
  @@index([lockedUntil])
}